{
  "name": "@samva/mailbox",
  "version": "0.7.1",
  "description": "Authoring SDK for Samva mailbox extensions",
  "keywords": [
    "authoring",
    "email",
    "mailbox",
    "samva",
    "sdk",
    "typescript"
  ],
  "homepage": "https://samva.dev",
  "bugs": {
    "url": "https://github.com/SamvaHQ/samva-typescript/issues"
  },
  "license": "MIT",
  "author": "Arya Labs, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamvaHQ/samva-typescript.git",
    "directory": "packages/mailbox"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "package.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "import": "./dist/webhook.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "typecheck": "tsc-rs --noEmit",
    "test": "vitest run --root ../.. --project packages packages/mailbox/tests"
  },
  "dependencies": {
    "@samva/webhooks": "workspace:0.28.1"
  },
  "devDependencies": {
    "tsc-rs": "catalog:",
    "tsdown": "^0.22.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
